# API Keys (Required)
REPLICATE_API_KEY=your_replicate_key_here
LEMONFOX_API_KEY=your_lemonfox_key_here
GEMINI_API_KEY=your_gemini_key_here

# Optional: ElevenLabs for premium voices
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Server Configuration
PORT=3000
NODE_ENV=production

# Optional: Password protect your instance (recommended for public deployments)
# Set a password here and you'll be prompted to enter it when accessing the app.
# Leave commented out for no password.
# AUTH_PASSWORD=your_secret_password

# Optional: For production deployments
# BASE_URL=https://yourdomain.com
